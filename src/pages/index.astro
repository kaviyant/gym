---
import BaseLayout from "../layouts/BaseLayout.astro";
const phone = "+918300168080";
const whatsapp = "https://wa.me/918300168080?text=Hi%20Atom%20The%20Fitness%20Club!%20I%20would%20like%20to%20know%20about%20your%20membership%20plans%20and%20training%20programs.";
const programs = [
  { n: "01", title: "Strength Training", desc: "Build strength through focused resistance training.", image: "/images/strength.jpeg" },
  { n: "02", title: "Bodybuilding", desc: "Work toward your physique goals with consistency.", image: "/images/bodybuilding.webp" },
  { n: "03", title: "Cardio Fitness", desc: "Improve endurance and build a stronger routine.", image: "/images/cardio.jpeg" },
  { n: "04", title: "Weight Loss", desc: "Create sustainable habits around movement and fitness.", image: "/images/weight-loss.jpeg" },
  { n: "05", title: "Personal Training", desc: "Ask the team about guidance for your fitness goals.", image: "/images/weight-loss.jpeg" },
  { n: "06", title: "Zumba", desc: "Explore energetic, movement-focused group workouts.", image: "/images/zumba.jpeg" }
];
---
<BaseLayout title="Atom The Fitness Club | Gym in Harur" description="Explore strength training, cardio, bodybuilding, weight-loss programs and fitness services at Atom The Fitness Club, Harur, Tamil Nadu.">
  <div class="announcement">YOUR FITNESS JOURNEY STARTS HERE <span>— HARUR, TAMIL NADU</span></div>
  <header class="site-header" id="top">
    <a class="brand" href="#top" aria-label="Atom The Fitness Club home"><span class="brand-mark">A<span>.</span></span><span class="brand-name">ATOM<small>THE FITNESS CLUB</small></span></a>
    <button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="main-nav"><span></span><span></span></button>
    <nav id="main-nav" class="main-nav">
      <a href="#about">About</a><a href="#programs">Programs</a><a href="#facilities">Facilities</a><a href="#gallery">Gallery</a><a href="#contact">Contact</a>
      <a class="nav-cta" href={whatsapp} target="_blank" rel="noopener noreferrer">JOIN THE CLUB <span>↗</span></a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <img class="hero-image" src="/images/hero-gym.webp" alt="Modern gym with strength-training equipment" fetchpriority="high" />
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <p class="eyebrow"><span class="eyebrow-line"></span> ATOM THE FITNESS CLUB · HARUR</p>
        <h1>BUILT BY<br /><span>DISCIPLINE.</span></h1>
        <p class="hero-copy">Train stronger. Move better. Become the best version of yourself.</p>
        <div class="hero-actions"><a class="button button-lime" href={whatsapp} target="_blank" rel="noopener noreferrer">START YOUR JOURNEY <span>↗</span></a><a class="button button-outline" href="#programs">EXPLORE THE CLUB <span>↓</span></a></div>
      </div>
      <div class="hero-bottom"><span>STRENGTH · FOCUS · PROGRESS</span><span class="scroll-note">SCROLL TO EXPLORE ↓</span></div>
    </section>

    <section class="benefit-strip" aria-label="Training options">
      <span>✳ STRENGTH & CONDITIONING</span><span>✳ CARDIO TRAINING</span><span>✳ PERSONAL TRAINING</span><span>✳ FITNESS COMMUNITY</span>
    </section>

    <section class="section about-section" id="about">
      <div class="about-photo image-frame"><img src="/images/strength.jpeg" alt="Athlete training with gym equipment" loading="lazy" /></div>
      <div class="about-copy">
        <p class="eyebrow">01 / ABOUT ATOM</p><h2>MORE THAN A GYM.<br /><span>A STRONGER YOU.</span></h2>
        <p class="muted">Your fitness journey deserves the right environment, consistent training, and a supportive community. Discover a space to work toward your strength, endurance, and fitness goals.</p>
        <ul class="check-list"><li><span>↗</span> Train with purpose</li><li><span>↗</span> Build consistent habits</li><li><span>↗</span> Progress at your own pace</li></ul>
        <a class="text-link" href="#contact">DISCOVER ATOM <span>↗</span></a>
      </div>
    </section>

    <section class="section programs-section" id="programs">
      <div class="section-heading"><div><p class="eyebrow">02 / FIND YOUR FOCUS</p><h2>TRAIN YOUR<br /><span>WAY.</span></h2></div><p class="muted heading-side">Different goals. One commitment: showing up and putting in the work.</p></div>
      <div class="program-grid">
        {programs.map((program) => <article class="program-card">
          <div class="program-image"><img src={program.image} alt={program.title} loading="lazy" /><span class="program-number">{program.n}</span><span class="program-arrow">↗</span></div>
          <div class="program-copy"><h3>{program.title}</h3><p>{program.desc}</p></div>
        </article>)}
      </div>
    </section>

    <section class="facilities-section" id="facilities">
      <div class="facilities-image"><img src="/images/facility-gym.webp" alt="Gym training area and equipment" loading="lazy" /></div>
      <div class="facilities-content"><p class="eyebrow">03 / THE EXPERIENCE</p><h2>THE RIGHT SPACE.<br /><span>THE RIGHT MINDSET.</span></h2><p class="muted">Build your routine in a fitness-focused environment with training options and wellness support to explore.</p>
        <div class="facility-list"><div><span>01</span><b>Modern workout equipment</b><i>↗</i></div><div><span>02</span><b>Separate workout areas</b><i>↗</i></div><div><span>03</span><b>Dietitian & physio support</b><i>↗</i></div><div><span>04</span><b>Diet kitchen</b><i>↗</i></div></div>
      </div>
    </section>

    <section class="motivation"><p class="eyebrow">NO SHORTCUTS. JUST PROGRESS.</p><h2>YOUR NEXT LEVEL<br />STARTS WITH <span>ONE REP.</span></h2><a class="button button-lime" href={whatsapp} target="_blank" rel="noopener noreferrer">TALK TO OUR TEAM <span>↗</span></a></section>

    <section class="section gallery-section" id="gallery">
      <div class="section-heading"><div><p class="eyebrow">04 / INSIDE THE CLUB</p><h2>BUILT FOR<br /><span>THE WORK.</span></h2></div><p class="muted heading-side">A glimpse of the training atmosphere. Replace these illustrative demo photos with real Atom photographs before publishing.</p></div>
      <div class="gallery-grid"><img src="/images/hero-gym.webp" alt="Gym interior" loading="lazy" /><img src="/images/bodybuilding.webp" alt="Strength training" loading="lazy" /><img src="/images/weight-loss.jpeg" alt="Fitness training session" loading="lazy" /></div>
    </section>

    <section class="join-section" id="contact"><div><p class="eyebrow">05 / YOUR MOVE</p><h2>READY TO MAKE<br /><span>A CHANGE?</span></h2><p class="muted">Ask about membership options, training programs, and visiting hours. Our team can help you take the next step.</p></div><div class="join-actions"><a class="button button-lime" href={whatsapp} target="_blank" rel="noopener noreferrer">ENQUIRE ON WHATSAPP <span>↗</span></a><a class="button button-outline" href={`tel:${phone}`}>CALL THE CLUB <span>↗</span></a></div></section>

    <section class="contact-section"><div><p class="eyebrow">COME FIND US</p><h2>MEET YOU<br /><span>AT ATOM.</span></h2></div><div class="contact-details"><p class="contact-label">LOCATION</p><p>Above Apollo Medicals,<br />Salem Bypass Road, Harur,<br />Tamil Nadu – 636903</p><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Atom+The+Fitness+Club+Above+Apollo+Medicals+Salem+Bypass+Road+Harur+Tamil+Nadu+636903" target="_blank" rel="noopener noreferrer">GET DIRECTIONS ↗</a></div><div class="contact-details"><p class="contact-label">CONNECT</p><p><a href={`tel:${phone}`}>+91 83001 68080</a><br /><a href="https://www.instagram.com/atom_thefitnessclub/" target="_blank" rel="noopener noreferrer">@atom_thefitnessclub</a></p><a class="text-link" href={whatsapp} target="_blank" rel="noopener noreferrer">MESSAGE ON WHATSAPP ↗</a></div></section>
  </main>

  <footer class="footer"><a class="brand" href="#top"><span class="brand-mark">A<span>.</span></span><span class="brand-name">ATOM<small>THE FITNESS CLUB</small></span></a><p>Train with purpose. Progress with consistency.</p><span class="copyright">© {new Date().getFullYear()} ATOM THE FITNESS CLUB · DEMO WEBSITE</span></footer>

  <!-- Floating contact buttons: right-side stack on desktop, bottom bar on mobile -->
  <aside class="floating-contact" aria-label="Quick contact">
    <a class="float-icon float-call" href={`tel:${phone}`} aria-label="Call Atom The Fitness Club" title="Call Atom The Fitness Club">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.35 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.08 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.84.57 2.8.69A2 2 0 0 1 22 16.92Z"/></svg>
    </a>
    <a class="float-icon float-whatsapp" href={whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Chat with Atom The Fitness Club on WhatsApp" title="WhatsApp Atom The Fitness Club">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.52 3.48A11.8 11.8 0 0 0 12.1 0C5.55 0 .22 5.33.22 11.88c0 2.1.55 4.15 1.6 5.96L.12 24l6.31-1.65a11.9 11.9 0 0 0 5.67 1.44h.01c6.55 0 11.88-5.33 11.88-11.88 0-3.17-1.23-6.15-3.47-8.43ZM12.1 21.78a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.75.98 1-3.65-.24-.38a9.86 9.86 0 0 1-1.52-5.26c0-5.46 4.45-9.91 9.92-9.91a9.84 9.84 0 0 1 7.02 2.91 9.84 9.84 0 0 1 2.9 7.02c0 5.47-4.45 9.92-9.92 9.92Zm5.44-7.43c-.3-.15-1.77-.87-2.05-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.47-.89-.8-1.49-1.78-1.66-2.08-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.38-.03-.53-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.08 4.49.71.31 1.27.5 1.7.64.72.23 1.37.2 1.88.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z"/></svg>
    </a>
  </aside>
  <script>
    const toggle = document.querySelector(".menu-toggle");
    const nav = document.querySelector("#main-nav");
    toggle?.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!open));
      toggle.setAttribute("aria-label", open ? "Open navigation" : "Close navigation");
      nav?.classList.toggle("is-open", !open);
      document.body.classList.toggle("menu-open", !open);
    });
    nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.setAttribute("aria-label", "Open navigation");
      nav.classList.remove("is-open");
      document.body.classList.remove("menu-open");
    }));
    window.addEventListener("scroll", () => {
      document.querySelector(".site-header")?.classList.toggle("scrolled", window.scrollY > 24);
    }, { passive: true });
  </script>
</BaseLayout>
